# ARQENIUM environment configuration (placeholders only - never commit real secrets)
#
# In the desktop app, provider credentials are stored encrypted locally and
# managed from Settings > Providers. Environment variables below are an
# optional fallback for headless/server usage (npm run start:api).

# Port for the local HTTP API used by web/desktop mode
ARQ_API_PORT=4319

# Data directory (defaults to ~/.arqenium when unset)
# ARQ_DATA_DIR=/path/to/data

# Provider API keys - leave blank if unused. The app works without any key.
ARQ_OPENAI_API_KEY=
ARQ_ANTHROPIC_API_KEY=
ARQ_GEMINI_API_KEY=

# OpenAI-compatible / local endpoints
ARQ_OPENAI_BASE_URL=
ARQ_OLLAMA_HOST=http://127.0.0.1:11434

# Set to 1 to allow anonymous product telemetry. Telemetry is disabled by
# default; ARQENIUM ships with no telemetry backend and collects nothing.
ARQ_TELEMETRY=0

# Hosted preview only: in-memory database plus a seeded sample project.
# Not needed for normal use - it exists so a headless demo host can boot.
# ARQ_DEMO_MODE=1
