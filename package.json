{
  "name": "arqenium",
  "version": "1.0.0",
  "description": "ARQENIUM - desktop-first engineering command center: multi-agent orchestration, project intelligence, MCP integrations, observability, and evaluation.",
  "license": "Apache-2.0",
  "author": "Mohamed El-Sayed Abdelfatah (M11)",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.js",
  "homepage": "https://github.com/M11-Developer/Arqenium",
  "repository": {
    "type": "git",
    "url": "https://github.com/M11-Developer/Arqenium.git"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "start:api": "tsx src/server/main.ts",
    "pack:dir": "electron-builder --dir",
    "dist": "electron-builder",
    "start:web": "node scripts/dev.mjs",
    "serve": "node dist/server/main.js",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "build:web": "node scripts/build.mjs --web"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^13.2.0",
    "chokidar": "^4.0.3",
    "jpeg-js": "^0.4.4",
    "node-html-parser": "^9.0.7",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tabler/icons-react": "^3.53.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.15.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@xyflow/react": "^13.0.0",
    "electron": "^44.11.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "zustand": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "build": {
    "appId": "dev.m11.arqenium",
    "productName": "ARQENIUM",
    "copyright": "Copyright \u00a9 2026 Mohamed El-Sayed Abdelfatah (M11)",
    "directories": {
      "output": "release",
      "buildResources": "public"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/better-sqlite3/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*",
      "node_modules/chokidar/**/*",
      "node_modules/readdirp/**/*",
      "node_modules/typescript/**/*",
      "node_modules/@modelcontextprotocol/**/*",
      "node_modules/zod/**/*",
      "node_modules/ajv/**/*",
      "node_modules/ajv-formats/**/*",
      "node_modules/chokidar/**/*",
      "node_modules/jpeg-js/**/*",
      "node_modules/pngjs/**/*",
      "node_modules/node-html-parser/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ARQENIUM-${version}-win-${arch}.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ARQENIUM",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "artifactName": "ARQENIUM-${version}-linux-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "ARQENIUM-${version}-mac-${arch}.${ext}"
    }
  }
}
